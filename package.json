        "@wordpress/scripts": "^34.1.0",
        "ajv": "^8.17.1"
    },
    "dependencies": {
        "@wordpress/block-editor": "^16.1.0",
        "@wordpress/blocks": "^15.25.0",
        "@wordpress/components": "^39.0.0",
        "@wordpress/data": "^10.36.0",
        "@wordpress/element": "^8.4.0",
        "@wordpress/i18n": "^6.26.0"
